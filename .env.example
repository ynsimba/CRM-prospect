# Local (Docker : npm run db:up)
DATABASE_URL="postgresql://baros:baros@localhost:5433/baros"
SESSION_SECRET="change-me-in-production-use-a-long-random-string"

# Production (Vercel) — à coller dans Project Settings > Environment Variables :
# DATABASE_URL  = chaîne Postgres hébergée, avec ?sslmode=require
# SESSION_SECRET = au moins 16 caractères aléatoires
# Puis : npx prisma migrate deploy && npx prisma db seed
