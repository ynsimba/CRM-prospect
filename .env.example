# Local (Docker : npm run db:up)
DATABASE_URL="postgresql://baros:baros@localhost:5433/baros"
SESSION_SECRET="change-me-in-production-use-a-long-random-string"

# Production (Neon + Vercel) — Prisma 6 : une seule URL pooled suffit
# DATABASE_URL  = postgresql://…-pooler…/neondb?sslmode=require
# SESSION_SECRET = au moins 16 caractères
# Puis : npm run db:deploy && npm run db:seed
