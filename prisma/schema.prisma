generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  SALES
}

enum ProspectPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ActivityType {
  CALL
  EMAIL
  WHATSAPP
  SMS
  MEETING
  VISIT
  DEMO
  NOTE
  OTHER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Organization {
  id         String  @id @default(cuid())
  name       String
  slug       String  @unique
  currency   String  @default("CDF")
  timezone   String  @default("Africa/Kinshasa")
  locale     String  @default("fr-CD")
  dateFormat String  @default("dd/MM/yyyy")
  phone      String?
  website    String?
  logoUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  teams            Team[]
  companies        Company[]
  contacts         Contact[]
  prospects        Prospect[]
  statuses         ProspectStatus[]
  sources          ProspectSource[]
  tags             Tag[]
  pipelines        Pipeline[]
  opportunities    Opportunity[]
  activities       Activity[]
  tasks            Task[]
  campaigns        Campaign[]
  notifications    Notification[]
  goals            Goal[]
  auditLogs        AuditLog[]
  subscription     Subscription?
  statusHistory    ProspectStatusHistory[]
  notes            UserNote[]
}

model Team {
  id             String @id @default(cuid())
  organizationId String
  name           String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      User[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id    String @id @default(cuid())
  code  String @unique
  label String

  roles RolePermission[]
}

model RolePermission {
  role           Role
  permissionCode String
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([role, permissionCode])
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  teamId         String?
  email          String
  passwordHash   String
  name           String
  civility       String?
  phone          String?
  role           Role
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team                 Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  ownedCompanies       Company[]
  ownedContacts        Contact[]
  ownedProspects       Prospect[]
  ownedOpportunities   Opportunity[]
  activities           Activity[]
  tasks                Task[]
  campaigns            Campaign[]
  notifications        Notification[]
  goals                Goal[]
  auditLogs            AuditLog[]
  tasksCreated         Task[]                   @relation("TaskAssignedBy")
  statusChanges        ProspectStatusHistory[]
  notes                UserNote[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@index([teamId])
}

model ProspectStatus {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  slug           String
  sortOrder      Int     @default(0)
  isConverted    Boolean @default(false)
  isLost         Boolean @default(false)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospects    Prospect[]
  history      ProspectStatusHistory[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model ProspectSource {
  id             String @id @default(cuid())
  organizationId String
  name           String
  slug           String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospects    Prospect[]
  campaigns    Campaign[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Tag {
  id             String @id @default(cuid())
  organizationId String
  name           String

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospects    ProspectTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Company {
  id             String  @id @default(cuid())
  organizationId String
  ownerId        String?
  name           String
  industry       String?
  website        String?
  email          String?
  phone          String?
  country        String?
  city           String?
  address        String?
  size           String?
  displayCode    String?
  status         String  @default("active")
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner         User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  contacts      Contact[]
  prospects     Prospect[]
  opportunities Opportunity[]
  activities    Activity[]
  tasks         Task[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([name])
}

model Contact {
  id             String  @id @default(cuid())
  organizationId String
  companyId      String?
  ownerId        String?
  firstName      String
  lastName       String
  civility       String?
  jobTitle       String?
  email          String?
  phone          String?
  whatsapp       String?
  linkedin       String?
  status         String  @default("active")
  category       String?
  displayCode    String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner         User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  prospects     Prospect[]
  opportunities Opportunity[]
  activities    Activity[]

  @@index([organizationId])
  @@index([companyId])
  @@index([email])
}

model Prospect {
  id              String            @id @default(cuid())
  organizationId  String
  companyId       String?
  contactId       String?
  ownerId         String?
  statusId        String
  sourceId        String?
  firstName       String
  lastName        String
  jobTitle        String?
  email           String?
  phone           String?
  whatsapp        String?
  website         String?
  country         String?
  city            String?
  address         String?
  industry        String?
  companySize     String?
  language        String?
  category        String?
  priority        ProspectPriority  @default(NORMAL)
  score           Int               @default(0)
  notes           String?
  statusComment   String?
  displayCode     String?
  firstContactAt  DateTime?
  lastActionAt    DateTime?
  nextContactAt   DateTime?
  lastContactAt   DateTime?
  marketingConsent Boolean          @default(false)
  convertedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company       Company?                 @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact       Contact?                 @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner         User?                    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  status        ProspectStatus           @relation(fields: [statusId], references: [id], onDelete: Restrict)
  source        ProspectSource?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  tags          ProspectTag[]
  opportunities Opportunity[]
  activities    Activity[]
  tasks         Task[]
  campaignLinks CampaignMember[]
  statusHistory ProspectStatusHistory[]

  @@index([organizationId, createdAt])
  @@index([statusId])
  @@index([ownerId])
  @@index([email])
  @@index([phone])
  @@index([nextContactAt])
}

model ProspectStatusHistory {
  id             String   @id @default(cuid())
  organizationId String
  prospectId     String
  statusId       String
  actorId        String?
  statusName     String
  statusSlug     String
  comment        String?
  displayCode    String?
  occurredAt     DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospect     Prospect      @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  status       ProspectStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([prospectId, occurredAt])
}

model ProspectTag {
  prospectId String
  tagId      String

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([prospectId, tagId])
  @@index([tagId])
}

model Pipeline {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model PipelineStage {
  id           String  @id @default(cuid())
  pipelineId   String
  name         String
  sortOrder    Int     @default(0)
  probability  Int     @default(0)
  isWon        Boolean @default(false)
  isLost       Boolean @default(false)

  pipeline      Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([pipelineId, sortOrder])
}

model Opportunity {
  id               String             @id @default(cuid())
  organizationId   String
  companyId        String?
  contactId        String?
  prospectId       String?
  pipelineId       String
  stageId          String
  ownerId          String?
  name             String
  amount           Int                @default(0)
  currency         String             @default("CDF")
  probability      Int                @default(0)
  expectedCloseAt  DateTime?
  status           OpportunityStatus  @default(OPEN)
  source           String?
  description      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  prospect     Prospect?     @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  pipeline     Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage        PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  activities   Activity[]
  tasks        Task[]

  @@index([organizationId, status])
  @@index([pipelineId, stageId])
  @@index([ownerId])
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  prospectId     String?
  companyId      String?
  contactId      String?
  opportunityId  String?
  type           ActivityType @default(NOTE)
  occurredAt     DateTime     @default(now())
  durationMin    Int?
  outcome        String?
  comment        String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  prospect     Prospect?    @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([prospectId])
  @@index([userId])
}

model Task {
  id             String         @id @default(cuid())
  organizationId String
  ownerId        String
  assignedById   String?
  prospectId     String?
  companyId      String?
  opportunityId  String?
  title          String
  displayCode    String?
  description    String?
  directorNote   String?
  ownerNote      String?
  priority       ProspectPriority @default(NORMAL)
  status         TaskStatus     @default(TODO)
  dueAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  assignedBy   User?        @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  prospect     Prospect?    @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([ownerId, dueAt])
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  ownerId        String?
  sourceId       String?
  name           String
  status         CampaignStatus @default(DRAFT)
  startsAt       DateTime?
  endsAt         DateTime?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  source       ProspectSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  members      CampaignMember[]

  @@index([organizationId])
}

model CampaignMember {
  campaignId String
  prospectId String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@id([campaignId, prospectId])
}

model UserNote {
  id             String   @id @default(cuid())
  organizationId String
  ownerId        String
  title          String
  body           String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt])
  @@index([organizationId])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String
  kind           String    @default("info")
  readAt         DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Goal {
  id                  String @id @default(cuid())
  organizationId      String
  userId              String?
  year                Int
  month               Int
  prospectsTarget     Int    @default(0)
  meetingsTarget      Int    @default(0)
  opportunitiesTarget Int    @default(0)
  revenueTarget       Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, year, month])
  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entity         String
  entityId       String?
  summary        String
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId])
}

model Plan {
  id           String @id @default(cuid())
  code         String @unique
  name         String
  maxUsers     Int
  maxProspects Int
  maxPipelines Int

  subscriptions Subscription[]
}

model Subscription {
  id               String             @id @default(cuid())
  organizationId   String             @unique
  planId           String
  status           SubscriptionStatus @default(TRIALING)
  currentPeriodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  events       BillingEvent[]
}

model BillingEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  type           String
  payload        Json?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}
